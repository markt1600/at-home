# Optional public identifier for a NEW friendly companion agent.
ELEVENLABS_AGENT_ID=
# Server-side secret used only by the Vercel voice function.
ELEVENLABS_API_KEY=
# Optional voice selections for authored greetings and replies.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=

# Private memory storage. Connect a PRIVATE Vercel Blob store to this project.
# Vercel supplies this secret; never prefix it with VITE_ or commit its value.
BLOB_READ_WRITE_TOKEN=
# A separate editor password, at least 6 characters. Server-side only.
MEMORY_ADMIN_PASSWORD=
